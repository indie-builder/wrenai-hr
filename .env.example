# Copy to an ignored local .env and supply secrets through your shell or Vercel.
# Generate a token with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
MCP_AUTH_TOKEN=
# Optional explicit domains, comma-separated, no wildcard; Vercel domains auto-detected.
MCP_ALLOWED_HOSTS=localhost:8320,127.0.0.1:8320
# Server-to-server clients normally omit Origin. Add exact browser origins only if needed.
MCP_ALLOWED_ORIGINS=
# Optional local override; production uses private hr_mcp/data built from demo seeds.
# MCP_DATA_DIR=/absolute/path/to/prepared-bundle
