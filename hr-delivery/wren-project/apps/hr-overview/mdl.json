{
  "catalog": "wren",
  "schema": "public",
  "dataSource": "duckdb",
  "layoutVersion": 3,
  "models": [
    {
      "name": "departments",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "departments"
      },
      "primaryKey": "dept_id",
      "properties": {
        "description": "部门维度表: 公司组织架构中的各部门 (9个一级部门)"
      },
      "columns": [
        {
          "name": "dept_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "部门ID(主键)"
          }
        },
        {
          "name": "dept_name",
          "type": "VARCHAR",
          "properties": {
            "description": "部门名称, 如: 技术部/产品部/人事部"
          }
        }
      ]
    },
    {
      "name": "employees",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "employees"
      },
      "primaryKey": "emp_id",
      "properties": {
        "description": "员工主表: 全量在职与离职员工档案 (截至2026-08-31)"
      },
      "columns": [
        {
          "name": "emp_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "员工ID(主键)"
          }
        },
        {
          "name": "gender",
          "type": "VARCHAR",
          "properties": {
            "description": "性别: 男/女"
          }
        },
        {
          "name": "hire_date",
          "type": "DATE",
          "properties": {
            "description": "入职日期"
          }
        },
        {
          "name": "dept_id",
          "type": "INTEGER",
          "properties": {
            "description": "所属部门ID(当前部门)"
          }
        },
        {
          "name": "job_level",
          "type": "VARCHAR",
          "properties": {
            "description": "职级: 初级/中级/高级/专家/总监/副总裁"
          }
        },
        {
          "name": "status",
          "type": "VARCHAR",
          "properties": {
            "description": "在职状态: 在职/离职"
          }
        },
        {
          "name": "base_salary",
          "type": "DOUBLE",
          "properties": {
            "description": "当前月基本工资(元, 税前)"
