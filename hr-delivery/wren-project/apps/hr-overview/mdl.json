        },
        {
          "name": "termination_reason",
          "type": "VARCHAR",
          "properties": {
            "description": "离职原因: 个人原因/薪酬原因/职业发展等"
          }
        }
      ]
    },
    {
      "name": "salary_payments",
      "tableReference": {
