        {
          "name": "pay_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "发放记录ID(主键)"
          }
        },
        {
          "name": "emp_id",
          "type": "INTEGER",
          "properties": {
            "description": "员工ID"
          }
        },
        {
          "name": "pay_period",
          "type": "VARCHAR",
          "properties": {
            "description": "薪资月份, 格式 YYYY-MM"
          }
        },
        {
          "name": "base_pay",
          "type": "DOUBLE",
          "properties": {
            "description": "基本工资(税前)"
          }
        },
        {
          "name": "overtime_pay",
          "type": "DOUBLE",
