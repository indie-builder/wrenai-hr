        {
          "name": "stage",
          "type": "VARCHAR",
          "properties": {
            "description": "当前阶段: 简历筛选/面试中/已发offer/已入职/已淘汰/拒绝offer"
          }
        },
        {
          "name": "applied_at",
          "type": "DATE",
          "properties": {
            "description": "投递日期"
          }
        },
        {
          "name": "hired_emp_id",
          "type": "INTEGER",
          "properties": {
            "description": "入职后关联的员工ID, 未入职为空"
          }
        }
      ]
    },
    {
      "name": "leave_requests",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "leave_requests"
      },
      "primaryKey": "leave_id",
      "properties": {
        "description": "请假申请单: 员工提交的各类假期申请"
      },
      "columns": [
        {
          "name": "leave_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "请假单ID(主键)"
          }
        },
        {
          "name": "leave_type",
          "type": "VARCHAR",
          "properties": {
            "description": "假期类型: 年假/事假/病假/婚假/产假/陪产假/调休"
          }
        },
        {
          "name": "start_date",
          "type": "DATE",
          "properties": {
            "description": "假期开始日期"
          }
        },
        {
          "name": "days",
          "type": "DOUBLE",
          "properties": {
            "description": "请假天数(支持0.5)"
          }
        },
        {
          "name": "status",
          "type": "VARCHAR",
          "properties": {
            "description": "审批状态: 已批准/待审批/已拒绝"
          }
        }
      ]
    },
    {
      "name": "offers",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "offers"
      },
      "primaryKey": "offer_id",
      "properties": {
        "description": "Offer发放记录"
      },
      "columns": [
        {
          "name": "offer_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "Offer ID(主键)"
          }
        },
        {
          "name": "offer_date",
          "type": "DATE",
          "properties": {
            "description": "发放日期"
          }
        },
        {
          "name": "status",
          "type": "VARCHAR",
          "properties": {
            "description": "状态: 待回复/已接受/已拒绝"
          }
        },
        {
          "name": "reject_reason",
          "type": "VARCHAR",
          "properties": {
            "description": "拒绝原因: 薪酬不匹配/已接其他offer/家庭原因/其他"
          }
        }
      ]
    },
    {
      "name": "recruitment_costs",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "recruitment_costs"
      },
      "primaryKey": "cost_id",
      "properties": {
        "description": "招聘渠道月度费用"
      },
      "columns": [
        {
          "name": "cost_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "费用记录ID(主键)"
          }
        },
        {
          "name": "channel",
          "type": "VARCHAR",
          "properties": {
            "description": "渠道: 招聘网站/猎头/内推奖励/校园招聘"
          }
        },
        {
          "name": "cost_month",
          "type": "VARCHAR",
          "properties": {
            "description": "费用月份, 格式 YYYY-MM"
          }
        },
        {
          "name": "amount",
          "type": "DOUBLE",
          "properties": {
            "description": "费用金额(元)"
          }
        }
      ]
    },
    {
      "name": "performance_goals",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "performance_goals"
      },
      "primaryKey": "goal_id",
      "properties": {
        "description": "绩效目标: 员工半年度 KPI/OKR 及完成率"
      },
      "columns": [
        {
          "name": "goal_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "目标ID(主键)"
          }
        },
        {
          "name": "emp_id",
          "type": "INTEGER",
          "properties": {
            "description": "员工ID"
          }
        },
        {
          "name": "review_period",
          "type": "VARCHAR",
          "properties": {
            "description": "考核周期, 格式如 2025H1"
          }
        },
        {
          "name": "weight",
          "type": "INTEGER",
          "properties": {
            "description": "权重(%)"
          }
        },
        {
          "name": "completion_pct",
          "type": "DOUBLE",
          "properties": {
            "description": "完成率(%)"
          }
        }
      ]
    },
    {
      "name": "engagement_surveys",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "engagement_surveys"
      },
      "primaryKey": "survey_id",
      "properties": {
        "description": "敬业度调研: 年度全员调研(1-5分)"
      },
      "columns": [
        {
          "name": "survey_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "调研记录ID(主键)"
          }
        },
        {
          "name": "survey_year",
          "type": "INTEGER",
          "properties": {
            "description": "调研年度"
          }
        },
        {
          "name": "engagement_score",
          "type": "DOUBLE",
          "properties": {
            "description": "敬业度总分(1-5)"
          }
        }
      ]
    },
    {
      "name": "exit_interviews",
      "tableReference": {
        "catalog": "",
        "schema": "public",
        "table": "exit_interviews"
      },
      "primaryKey": "exit_id",
      "properties": {
        "description": "离职面谈: 离职员工真实原因调研"
      },
      "columns": [
        {
          "name": "exit_id",
          "type": "INTEGER",
          "notNull": true,
          "properties": {
            "description": "面谈记录ID(主键)"
          }
        },
        {
          "name": "real_reason_category",
          "type": "VARCHAR",
          "properties": {
            "description": "真实原因归类: 薪酬福利/职业发展/管理问题/工作文化/家庭个人/健康"
          }
        }
      ]
    }
  ],
  "views": [
    {
      "name": "v_active_employees",
      "properties": {
        "description": "在职员工宽表: 员工档案 + 部门名称, 仅 status=在职 (人员分析用)"
      },
      "statement": "SELECT d.dept_name, e.job_level, e.gender, e.base_salary FROM employees AS e JOIN departments AS d ON e.dept_id = d.dept_id WHERE e.status = '在职'"
    },
    {
      "name": "v_monthly_salary",
      "properties": {
        "description": "月度薪资宽表: 薪资发放 + 员工 + 部门 (人力成本=base_pay+overtime_pay+bonus 在查询时计算)"
      },
      "statement": "SELECT s.pay_period, s.base_pay, s.overtime_pay, s.bonus FROM salary_payments AS s JOIN employees AS e ON s.emp_id = e.emp_id JOIN departments AS d ON e.dept_id = d.dept_id"
    },
    {
      "name": "v_workforce_monthly",
      "properties": {
        "description": "人力成本月度明细宽表: 薪资行 + 社保企业缴纳 (人效/总成本分析用, 聚合在查询时完成)"
      },
      "statement": "SELECT s.pay_period, s.base_pay, s.overtime_pay, s.bonus, i.company_total AS insurance_company FROM salary_payments AS s JOIN insurance_payments AS i ON i.emp_id = s.emp_id AND i.pay_period = s.pay_period JOIN employees AS e ON e.emp_id = s.emp_id JOIN departments AS d ON d.dept_id = e.dept_id"
    },
    {
      "name": "v_headcount_vs_plan",
      "properties": {
        "description": "编制达成宽表: 部门年度计划编制 vs 年末实际在职人数"
      },
      "statement": "SELECT p.plan_year, d.dept_name, p.planned_headcount, COALESCE(a.actual_headcount, 0) AS actual_headcount FROM headcount_plan AS p JOIN departments AS d ON d.dept_id = p.dept_id LEFT JOIN (SELECT y.yr_end, e.dept_id, COUNT(*) AS actual_headcount FROM (SELECT CAST('2023-12-31' AS DATE) AS yr_end UNION ALL SELECT CAST('2024-12-31' AS DATE) UNION ALL SELECT CAST('2025-12-31' AS DATE) UNION ALL SELECT CAST('2026-12-31' AS DATE)) AS y JOIN employees AS e ON e.hire_date <= y.yr_end AND (e.termination_date IS NULL OR e.termination_date > y.yr_end) GROUP BY y.yr_end, e.dept_id) AS a ON a.yr_end = MAKE_DATE(p.plan_year, 12, 31) AND a.dept_id = p.dept_id"
    }
  ],
  "relationships": [
    {
      "name": "employees_department",
      "models": [
        "employees",
        "departments"
      ],
      "joinType": "many_to_one",
      "condition": "employees.dept_id = departments.dept_id"
    },
    {
      "name": "salary_payments_employee",
      "models": [
        "salary_payments",
        "employees"
      ],
      "joinType": "many_to_one",
      "condition": "salary_payments.emp_id = employees.emp_id"
    },
    {
      "name": "candidates_hired_employee",
      "models": [
        "candidates",
        "employees"
      ],
      "joinType": "many_to_one",
      "condition": "candidates.hired_emp_id = employees.emp_id"
    },
    {
      "name": "headcount_plan_department",
      "models": [
        "headcount_plan",
        "departments"
      ],
      "joinType": "many_to_one",
      "condition": "headcount_plan.dept_id = departments.dept_id"
    },
    {
      "name": "insurance_payments_employee",
      "models": [
        "insurance_payments",
        "employees"
      ],
      "joinType": "many_to_one",
      "condition": "insurance_payments.emp_id = employees.emp_id"
    },
    {
      "name": "performance_goals_employee",
      "models": [
        "performance_goals",
        "employees"
      ],
      "joinType": "many_to_one",
      "condition": "performance_goals.emp_id = employees.emp_id"
    }
  ],
  "cubes": [
    {
      "name": "workforce",
      "baseObject": "v_active_employees",
      "properties": {
        "description": "人员编制 cube: 在职人数/平均工资, 支持按部门/职级/城市等维度"
      },
      "measures": [
        {
          "name": "headcount",
          "expression": "COUNT(*)",
          "type": "BIGINT"
        },
        {
          "name": "avg_base_salary",
          "expression": "AVG(base_salary)",
          "type": "DOUBLE"
        }
      ],
      "dimensions": [
        {
          "name": "dept_name",
          "expression": "dept_name",
          "type": "VARCHAR"
        },
        {
          "name": "job_level",
          "expression": "job_level",
          "type": "VARCHAR"
        },
        {
          "name": "gender",
          "expression": "gender",
          "type": "VARCHAR"
        }
      ],
      "timeDimensions": []
    },
    {
      "name": "labor_cost",
      "baseObject": "v_monthly_salary",
      "properties": {
        "description": "人力成本 cube: 月度应发/实发合计与发薪人数, 按部门/职级维度"
      },
      "measures": [
        {
          "name": "gross_cost",
          "expression": "SUM(base_pay + overtime_pay + bonus)",
          "type": "DOUBLE"
        }
      ],
      "dimensions": [
        {
          "name": "pay_period",
          "expression": "pay_period",
          "type": "VARCHAR"
        }
      ],
      "timeDimensions": []
    },
    {
      "name": "recruitment",
      "baseObject": "candidates",
      "properties": {
        "description": "招聘漏斗 cube: 候选人数与入职转化, 按来源/阶段维度"
      },
      "measures": [
        {
          "name": "candidate_count",
          "expression": "COUNT(*)",
          "type": "BIGINT"
        },
        {
          "name": "hired_count",
          "expression": "SUM(CASE WHEN stage = '已入职' THEN 1 ELSE 0 END)",
          "type": "BIGINT"
        }
      ],
      "dimensions": [],
      "timeDimensions": [
        {
          "name": "applied_at",
          "expression": "applied_at",
          "type": "DATE"
        }
      ]
    },
    {
      "name": "total_cost",
      "baseObject": "v_workforce_monthly",
      "properties": {
        "description": "人力总成本 cube: 税前应发加社保企业缴纳, 一人一月一行; 人均月成本=total_cost/person_months, 部门按当前档案归属"
      },
      "measures": [
        {
          "name": "total_cost",
          "expression": "SUM(base_pay + overtime_pay + bonus + insurance_company)",
          "type": "DOUBLE"
        },
        {
          "name": "person_months",
          "expression": "COUNT(*)",
          "type": "BIGINT"
        },
        {
          "name": "base_total",
          "expression": "SUM(base_pay)",
          "type": "DOUBLE"
        },
        {
          "name": "overtime_total",
          "expression": "SUM(overtime_pay)",
          "type": "DOUBLE"
        },
        {
          "name": "bonus_total",
          "expression": "SUM(bonus)",
          "type": "DOUBLE"
        },
        {
          "name": "insurance_total",
          "expression": "SUM(insurance_company)",
          "type": "DOUBLE"
        }
      ],
      "dimensions": [
        {
          "name": "pay_period",
          "expression": "pay_period",
          "type": "VARCHAR"
        }
      ],
      "timeDimensions": []
    },
    {
      "name": "headcount_plan_cube",
      "baseObject": "v_headcount_vs_plan",
      "properties": {
        "description": "编制达成 cube: 计划编制 vs 年末实际在职"
      },
      "measures": [
        {
          "name": "planned_total",
          "expression": "SUM(planned_headcount)",
          "type": "BIGINT"
        },
        {
          "name": "actual_total",
          "expression": "SUM(actual_headcount)",
          "type": "BIGINT"
        }
      ],
      "dimensions": [
        {
          "name": "plan_year",
          "expression": "plan_year",
          "type": "INTEGER"
        },
        {
          "name": "dept_name",
          "expression": "dept_name",
          "type": "VARCHAR"
        }
      ],
      "timeDimensions": []
    }
  ]
}
