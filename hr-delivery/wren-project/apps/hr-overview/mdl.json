        },
        {
          "name": "plan_year",
          "type": "INTEGER",
          "properties": {
            "description": "规划年度"
          }
        },
        {
          "name": "dept_id",
          "type": "INTEGER",
          "properties": {
            "description": "部门ID"
          }
        },
        {
          "name": "planned_headcount",
          "type": "INTEGER",
          "properties": {
            "description": "计划编制人数(年末)"
          }
        }
      ]
    },
    {
      "name": "candidates",
      "tableReference": {
        "catalog": "",
        "schema": "public",
